# Copy this file to secrets.toml and fill in your values.
# Local path:  .streamlit/secrets.toml   (gitignored — never commit real secrets)
# Streamlit Cloud: App settings → Secrets → paste the same TOML

# ── Permanent member accounts (REQUIRED on Streamlit Cloud) ───────────────
# Free options:
#   Neon:     https://neon.tech  → New project → Connection string (URI)
#   Supabase: https://supabase.com → Project Settings → Database → URI
#
# Without this, accounts are stored in local SQLite and are WIPED on every
# Streamlit Cloud redeploy. That is why login says "No accounts found".
[database]
url = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

[auth]
# Signup alerts go here
notify_email = "ImzCpr@gmail.com"
# Founder / admin account (only this email gets Admin panel)
admin_email = "imzcpr@gmail.com"
# Mixed into password hashes — set once, never change after users exist
pepper = "change-me-to-a-long-random-string-keep-stable"
# Auto-create founder account if missing (min 8 chars). Keep private.
bootstrap_password = "Liam09062018"

[smtp]
# Gmail App Password: https://myaccount.google.com/apppasswords
host = "smtp.gmail.com"
port = 587
username = "ImzCpr@gmail.com"
password = "your-16-char-app-password"
from_email = "ImzCpr@gmail.com"

# Optional: per-user journal capacity (default 50)
# [journal]
# max_entries = 50
