# Copy this file to secrets.toml and fill in your values.
# Local path:  .streamlit/secrets.toml   (gitignored — never commit real secrets)
# Streamlit Cloud: App settings → Secrets → paste the same TOML

[auth]
# Where new subscriber signup alerts are sent
notify_email = "ImzCpr@gmail.com"
# Optional extra secret mixed into password hashes (use a long random string)
pepper = "change-me-to-a-long-random-string"

[smtp]
# Gmail example (use an App Password, not your normal login password):
# https://myaccount.google.com/apppasswords
host = "smtp.gmail.com"
port = 587
username = "ImzCpr@gmail.com"
password = "your-16-char-app-password"
from_email = "ImzCpr@gmail.com"

# Optional: per-user journal capacity (default 50)
# [journal]
# max_entries = 50
