# Copy this file to secrets.toml and fill in your values.
# Local path:  .streamlit/secrets.toml   (gitignored — never commit real secrets)
# Streamlit Cloud: App settings → Secrets → paste the same TOML

[auth]
# Where new subscriber signup alerts are sent
notify_email = "ImzCpr@gmail.com"
# Only this account is ADMIN / FOUNDER (in-app edits)
admin_email = "ImzCpr@gmail.com"
# Optional extra secret mixed into password hashes.
# IMPORTANT: set this once and do NOT change it, or existing passwords stop working.
pepper = "change-me-to-a-long-random-string-keep-stable"
# Founder password used to auto-recreate the admin account after Streamlit Cloud
# redeploys (Cloud wipes data/users.db). Min 8 characters. Keep private.
bootstrap_password = "set-a-strong-founder-password"

[smtp]
# Gmail example (use an App Password, not your normal login password):
# https://myaccount.google.com/apppasswords
host = "smtp.gmail.com"
port = 587
username = "ImzCpr@gmail.com"
password = "your-16-char-app-password"
from_email = "ImzCpr@gmail.com"

# Optional: per-user journal capacity (default 50)
# [journal]
# max_entries = 50
